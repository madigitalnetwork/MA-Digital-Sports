# Copy to .env.local for local development, and set the same key in the
# Vercel dashboard under Settings -> Environment Variables.
#
# This is your RapidAPI key for the "Free Cricbuzz Cricket API"
# (https://rapidapi.com/Creativesdev/api/free-cricbuzz-cricket-api).
# It is sent upstream in the x-rapidapi-key header.
CRIC_API_KEY=your_rapidapi_key_here

# RAPIDAPI_KEY is accepted as an alias for CRIC_API_KEY, if you prefer that name.
# RAPIDAPI_KEY=

# Optional: pin the scoreboard to one specific match id (Cricbuzz matchId)
# instead of whichever match happens to be live.
# MATCH_ID=
